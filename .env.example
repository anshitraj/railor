# ---------------------------------------------------------------------------
# Railor — development environment
# Copy to .env and adjust. Everything below has a working local default.
# ---------------------------------------------------------------------------

# Postgres.
# Leave unset for the zero-setup default: an embedded Postgres (PGlite) stored
# in .railor/pglite. Set it to use a real server — `pnpm db:up` starts one via
# docker compose on 5433, and any hosted Postgres URL works too.
# DATABASE_URL=postgresql://railor:railor@localhost:5433/railor

# Public origin, used in magic links and share URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie signing secret. Any long random string in dev.
AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789

# Magic-link delivery. "console" prints the link to the server log (dev default).
# Set to "smtp" and fill SMTP_* to actually send mail.
AUTH_EMAIL_TRANSPORT=console
SMTP_URL=
AUTH_FROM=Railor <no-reply@railor.dev>

# OAuth (optional). Buttons stay visible but announce "not configured" if unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM adapter for query interpretation + extraction.
# Unset = deterministic rule-based interpreter only (fully functional).
ANTHROPIC_API_KEY=
RAILOR_LLM_MODEL=claude-sonnet-5

# Worker (apps/worker)
REDIS_URL=redis://localhost:6379/0
SNAPSHOT_DIR=./storage/snapshots
