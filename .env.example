# ---------------------------------------------------------------------------
# Railor — development environment
# Copy to .env and adjust. Everything below has a working local default.
# ---------------------------------------------------------------------------

# Postgres.
# Leave unset for the zero-setup default: an embedded Postgres (PGlite) stored
# in .railor/pglite. Set it to use a real server — `pnpm db:up` starts one via
# docker compose on 5433, and any hosted Postgres URL works too.
# DATABASE_URL=postgresql://railor:railor@localhost:5433/railor

# Public origin, used in magic links and share URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Canonical auth and CSRF origin. Required as HTTPS in production.
APP_ORIGIN=http://localhost:3000
FOUNDING_PAYMENT_LINK=
PAYMENT_LINK_ALLOWED_HOSTS=buy.stripe.com,checkout.stripe.com

# Session cookie signing secret. Any long random string in dev.
AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789

# Magic-link delivery. "console" prints the link to the server log (dev default) —
# fine for local dev, useless in production since nobody but you can see those logs.
# Set to "smtp" and fill SMTP_URL to actually send mail. Any SMTP-speaking
# provider works via one connection string; with Resend (recommended, generous
# free tier) it's:
#   SMTP_URL=smtps://resend:{your Resend API key}@smtp.resend.com:465
AUTH_EMAIL_TRANSPORT=console
SMTP_URL=
AUTH_FROM=Railor <no-reply@railor.dev>

# OAuth (optional). Buttons stay visible but announce "not configured" if unset.
# Register the redirect URI with each provider as:
#   {APP_ORIGIN}/api/auth/oauth/google/callback
#   {APP_ORIGIN}/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LLM adapter for query interpretation + extraction — fills fields the
# deterministic rules leave blank, never overrides what rules already found.
# Unset = deterministic rule-based interpreter only (fully functional).
# Get a key at https://aistudio.google.com/apikey — check that console for
# the current flagship model name, since it moves faster than this file does.
GEMINI_API_KEY=
# Optional invoice/receipt extraction model; falls back to RAILOR_LLM_MODEL.
RAILOR_INVOICE_MODEL=gemini-flash-latest
# Vertex uses Application Default Credentials when enabled; otherwise GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
RAILOR_LLM_MODEL=gemini-flash-latest

# Encrypts provider credentials, beneficiary account details and webhook
# signing secrets (AES-256-GCM). Unset = Railor refuses to save any of them
# rather than store plaintext (so beneficiaries/payments need it too).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# Railor-owned Airwallex FX pricing (backend only; never NEXT_PUBLIC_).
# Defaults to sandbox. Existing lowercase airwallex_sandbox_client_id and
# airwallex_sandbox_scoped_api are also accepted. No visitor keys required.
AIRWALLEX_PLATFORM_ENVIRONMENT=sandbox
AIRWALLEX_SANDBOX_CLIENT_ID=
AIRWALLEX_SANDBOX_API_KEY=
# Separate production keys, used only when environment=production. These
# supply indicative Railor-account rates, NOT customer-specific execution.
AIRWALLEX_PLATFORM_CLIENT_ID=
AIRWALLEX_PLATFORM_API_KEY=
# Sandbox observations are hidden in production by default. Only enable for
# a clearly labelled private test/demo deployment, never as real pricing.
RAILOR_SHOW_SANDBOX_QUOTES=false

# Worker (apps/worker)
SNAPSHOT_DIR=./storage/snapshots
GCS_SNAPSHOT_BUCKET=

# Shared secret for the scheduler hooks under /api/internal/:
#   POST /api/internal/payments-reconcile   every minute (moves open payments
#        to their provider-reported state; resolves "unknown" outcomes)
#   POST /api/internal/webhook-deliveries   every minute (signed outbound
#        webhooks, retried with backoff)
#   POST /api/internal/decision-monitor     frequently
#   POST /api/internal/usage-rollup         daily
# Unset = the routes refuse to run. Point an external scheduler at them with
# Authorization: Bearer <secret>; nothing invokes them automatically.
CRON_SECRET=

# Money movement. Test-mode payments (sandbox connections or Railor's
# simulator) always work. Live payments additionally need this switch, a
# workspace approved in /admin/organizations (with limits), a provider
# approved in /admin/providers, and a production connection.
RAILOR_LIVE_PAYMENTS=disabled

# Provider logos are fetched once from each provider's own website and
# cached. Set to "off" for offline or test environments (monograms instead).
# RAILOR_REMOTE_LOGOS=off

# Web discovery (apps/worker, Google Search grounding). Reuses GEMINI_API_KEY
# (or Vertex via GOOGLE_GENAI_USE_VERTEXAI). The model must support search grounding.
# RAILOR_DISCOVERY_MODEL=gemini-2.5-flash

# Shared read cache for the provider graph, reference data and platform counts
# (per server process, stale-while-revalidate). Milliseconds; 0 disables.
# RAILOR_READ_CACHE_MS=120000

# Migrations. Unset = migrate automatically only an embedded PGlite or a local
# Postgres in development; a hosted database (Neon, production) is checked and
# the app refuses to start against pending migrations instead of applying them.
# Apply deliberately: pnpm db:migrate -- --dry-run, then -- --confirm-remote.
# RAILOR_AUTO_MIGRATE=false

# Country intelligence pipeline (Tavily search + Gemini structured
# extraction — reuses GEMINI_API_KEY above, no separate LLM key needed).
# Backend-only — never exposed to the browser, never NEXT_PUBLIC_. Runs ONLY
# via `pnpm research-country -- <ISO2>` or an authenticated admin refresh
# (POST /api/admin/countries/:code/refresh); GET /api/countries/:code reads
# the database only and never calls Tavily/Gemini/Firecrawl.
# Get a Tavily key at https://tavily.com.
TAVILY_API_KEY=
# Extraction model — deliberately separate from RAILOR_LLM_MODEL above:
# this task is rare and quality-sensitive (favors Pro), query interpretation
# is frequent and latency-sensitive (favors Flash). Check the AI Studio
# console for the current flagship "pro" model name if this one has aged out.
COUNTRY_RESEARCH_LLM_MODEL=gemini-3.1-pro-preview
# Optional fallback content fetcher for URLs Tavily's own extract() can't
# retrieve. Unset = that fallback is skipped; the pipeline still runs on
# Tavily alone. Get a key at https://firecrawl.dev.
FIRECRAWL_API_KEY=
# Optional additional search+extract backend (packages/core/src/country-research/parallel.ts).
# Get a key at https://platform.parallel.ai. Real paid credit — every call goes
# through the durable ledger in packages/core/src/country-research/parallel-ledger.ts
# first, which reserves budget before the request and refuses to spend past
# (PARALLEL_MAX_SPEND_USD - PARALLEL_RESERVE_USD). Set a scope to share one
# cumulative ledger across short-lived scripts.
PARALLEL_API_KEY=
PARALLEL_MAX_SPEND_USD=20
PARALLEL_RESERVE_USD=5
PARALLEL_BUDGET_SCOPE=railor-global
# Authenticated corridor search can request a one-hour-cached fresh-market
# pass when the verified catalog cannot confirm the exact route. Tavily finds
# sources, Gemini structures citation-bound leads, and Parallel is a budgeted
# fallback when too few sources are found. These leads never become verified
# capabilities or executable quotes automatically.
MARKET_DISCOVERY_LLM_MODEL=gemini-flash-latest
MARKET_DISCOVERY_PARALLEL_SCOPE=market-discovery
COUNTRY_RESEARCH_MAX_QUERIES=9
COUNTRY_RESEARCH_MAX_RESULTS_PER_QUERY=5
COUNTRY_RESEARCH_MAX_SOURCE_DOCS=20
COUNTRY_RESEARCH_MAX_CHARS_TO_LLM=60000
COUNTRY_RESEARCH_MIN_RECHECK_HOURS=20

# Provider route-matrix research (Phase 1+ of the "0 exact routes" fix).
# Distinct from providerConnections in schema.ts (that's a customer's own
# credentials, entered through the app, for executing their own transfers —
# Railor never touches those). These are Railor's own backend research keys,
# used only by the one-off importers below to pull real routes/quotes into
# provider_routes + evidence. Never exposed to the browser.
#
# Circle Payments Network (CPN) — sandbox or production key both work; CPN
# uses one host (api.circle.com) for both, unlike Circle's separate core
# Payments API. Get one at https://console.circle.com (Payments Network
# product). Runs via `pnpm --filter @railor/core circle-cpn-route-import`.
CIRCLE_RESEARCH_API_KEY=
# Bridge — sandbox key from https://dashboard.bridge.xyz. Endpoint/auth
# already verified empirically (see packages/core/src/adapters.ts) but no
# route importer exists yet — needs a real key to build one that isn't guessed.
BRIDGE_RESEARCH_API_KEY=
# Nium — sandbox signup at https://app.nium.com/sign-up. Auth is x-api-key
# header + a clientHashId path parameter (docs.nium.com/docs/developers/
# nium-api/authentication) — sandbox base URL wasn't confirmed from public
# docs this session; check your Nium portal's own onboarding page for it.
NIUM_RESEARCH_API_KEY=
NIUM_RESEARCH_CLIENT_HASH_ID=
