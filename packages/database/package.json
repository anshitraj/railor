{
  "name": "@railor/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "push": "drizzle-kit push",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate-run.ts",
    "seed": "tsx src/seed/run.ts",
    "receiving-endpoints": "tsx src/seed/receiving-endpoints.ts",
    "stablecoin-capabilities": "tsx src/seed/stablecoin-capabilities.ts",
    "provider-batch-2": "tsx src/seed/provider-batch-2.ts",
    "reset": "tsx src/seed/reset.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@railor/types": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
